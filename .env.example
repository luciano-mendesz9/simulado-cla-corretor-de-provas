# URL pooled do Neon para a aplicação.
DATABASE_URL=
# URL direta do Neon para migrations e criação manual de coordenador.
DIRECT_URL=
# Use segredos aleatórios independentes de pelo menos 32 bytes cada.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
NODE_ENV=development
# Local: FastAPI service. In Vercel, the private service binding provides this URL.
OMR_SERVICE_URL=http://127.0.0.1:8001/
# Independent random secret (at least 32 bytes), configured on both services.
OMR_SHARED_SECRET=
