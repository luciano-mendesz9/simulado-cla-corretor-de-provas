{
  "name": "simulado-cla-fullstack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "omr:dev": "sh -c 'if [ -f .env.local ]; then omr_env_file=.env.local; else omr_env_file=.env; fi; exec python/.venv/bin/uvicorn --app-dir python main:app --host 127.0.0.1 --port 8001 --env-file \"$omr_env_file\"'",
    "omr:test": "python/.venv/bin/pytest -q python/tests",
    "omr:benchmark": "python/.venv/bin/python python/benchmark.py",
    "omr:fixture": "node --import tsx scripts/generate-omr-fixture.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "create:coordinator": "tsx scripts/create-coordinator.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "pdfjs-dist": "^5.4.394",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
